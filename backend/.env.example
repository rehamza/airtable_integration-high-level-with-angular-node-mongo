NODE_ENV=development
APP_NAME=Airtable Integration System API
APP_URL=http://localhost:3007
FRONTEND_URL=http://localhost:4200
FRONTEND_AUTH_CALLBACK_PATH=/auth/airtable/callback
API_PREFIX=api
PORT=3007
LOG_LEVEL=debug

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=airtable_integration_system
MONGODB_AUTO_INDEX=true
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
AIRTABLE_REDIRECT_URI=http://localhost:3007/api/integrations/airtable/callback
AIRTABLE_SCOPES=data.records:read,schema.bases:read,user.email:read
AIRTABLE_API_BASE_URL=https://api.airtable.com
AIRTABLE_METADATA_BASE_URL=https://api.airtable.com/v0/meta
AIRTABLE_OAUTH_AUTHORIZE_URL=https://airtable.com/oauth2/v1/authorize
AIRTABLE_OAUTH_TOKEN_URL=https://airtable.com/oauth2/v1/token
AIRTABLE_DEFAULT_INTEGRATION_KEY=default
AIRTABLE_PKCE_TTL_MINUTES=15
AIRTABLE_TOKEN_REFRESH_BUFFER_SECONDS=120
AIRTABLE_RATE_LIMIT_PER_SECOND=5
AIRTABLE_PAGE_SIZE=100

AIRTABLE_SESSION_EMAIL=
AIRTABLE_SESSION_PASSWORD=
AIRTABLE_MFA_SECRET=

PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_DEFAULT_TIMEOUT_MS=30000
PUPPETEER_NAVIGATION_TIMEOUT_MS=45000

SCRAPER_COOKIE_TTL_HOURS=12
SCRAPER_CONCURRENCY=2
